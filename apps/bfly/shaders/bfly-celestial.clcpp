// Render premultiplied RGBA8 in UI4's top-origin coordinates.
static float celestial_alpha(__global const uchar *atlas, float2 pixel, float2 size,
                             uint body, float2 rotation)
{
    const bool sun = body == 3u;
    const uint2 source_size = sun ? (uint2)(1000u, 560u) : (uint2)(512u);
    float2 offset = pixel + 0.5f - 0.5f * size;
    if (!sun) {
        offset *= 512.0f / size;
    }
    if (body >= 2u && any(rotation != 0.0f)) {
        // Inverse sampling makes positive angles clockwise in top-origin coordinates.
        offset = (float2)(rotation.x * offset.x + rotation.y * offset.y,
                          rotation.x * offset.y - rotation.y * offset.x);
    }
    // The reference's disk is slightly off-center in the image.
    const float2 pivot = sun ? (float2)(541.0f, 246.0f) : (float2)(255.5f);
    const float2 sample = offset + pivot;
    const float2 max_sample = convert_float2(source_size) - 1.0f;
    if (any(sample < -0.5f) || any(sample > max_sample + 0.5f)) {
        return 0.0f;
    }
    const float2 uv = clamp(sample, 0.0f, max_sample);
    const uint2 lo = convert_uint2(uv);
    const uint2 hi = min(lo + 1u, source_size - 1u);
    const float2 fraction = uv - convert_float2(lo);
    const uint base = (body - 1u) * 512u * 512u;
    const uint top = base + lo.y * source_size.x;
    const uint bottom = base + hi.y * source_size.x;
    const float upper = mix(convert_float(atlas[top + lo.x]),
                            convert_float(atlas[top + hi.x]), fraction.x);
    const float lower = mix(convert_float(atlas[bottom + lo.x]),
                            convert_float(atlas[bottom + hi.x]), fraction.x);
    return mix(upper, lower, fraction.y) / 255.0f;
}

static float gradient_alpha(uint x, uint y, uint width, uint height)
{
    const float u = width > 1 ? convert_float(x) / convert_float(width - 1) : 0.5f;
    const float v = height > 1 ? convert_float(y) / convert_float(height - 1) : 0.5f;
    const float t = clamp(v - u, 0.0f, 1.0f);
    const float ideal = (255.0f * 0.33f) * t * t * (3.0f - 2.0f * t);
    // A fixed 4x4 Bayer pattern retains fractional alpha without temporal noise.
    const uint low = (2u * ((x ^ y) & 1u)) + (y & 1u);
    const uint high = ((x ^ y) & 2u) + ((y >> 1u) & 1u);
    const float dither = (convert_float(4u * low + high) + 0.5f) / 16.0f;
    return floor(ideal + dither) / 255.0f;
}

kernel __attribute__((intel_reqd_sub_group_size(16))) void shadertoy_bfly_celestial(
    __global uint *output,
    __global const float4 *uniforms,
    uint width,
    uint height,
    uint pitch_bytes,
    __global const uchar *atlas)
{
    const uint x = get_global_id(0);
    const uint y = get_global_id(1);
    if (x >= width || y >= height) {
        return;
    }

    const float2 point = convert_float2((uint2)(x, y));
    const float4 region = uniforms[5];
    if (as_uint(uniforms[4].x) == 0u &&
        (any(point < region.xy) || any(point >= region.zw))) {
        return;
    }

    const float4 sprite = uniforms[1];
    const float4 appearance = uniforms[2];
    const float2 size = (float2)(sprite.z, appearance.w > 0.0f ? appearance.w : sprite.z);
    const float2 pixel = point - sprite.xy;
    const float body = uniforms[0].w;
    float opacity = 0.0f;
    if (body >= 1.0f && body <= 3.0f && sprite.w > 0.0f &&
        all(pixel >= 0.0f) && all(pixel < size)) {
        opacity = sprite.w * celestial_alpha(atlas, pixel, size, convert_uint(body), appearance.yz);
    }

    const float gradient = gradient_alpha(x, y, width, height) * (1.0f - opacity);
    const uint white = convert_uint_sat_rte(255.0f * (opacity + gradient * appearance.x));
    const uint alpha = convert_uint_sat_rte(255.0f * (opacity + gradient));
    output[(size_t)y * (pitch_bytes / sizeof(uint)) + x] = (alpha << 24) | (white * 0x010101u);
}
