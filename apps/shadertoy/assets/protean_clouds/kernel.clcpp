inline float2 st_refract(float2 incident, float2 normal, float eta) {
    float ni = dot(normal, incident);
    float k = 1.0f - eta * eta * (1.0f - ni * ni);
    return k < 0.0f ? (float2)(0.0f)
                    : eta * incident - (eta * ni + sqrt(k)) * normal;
}
