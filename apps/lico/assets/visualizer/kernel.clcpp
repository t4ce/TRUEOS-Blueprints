// Lico's spectral aperture. All signal and playhead data comes from the
// current audio graph. The dispatch writes one opaque RGBA8 pixel per lane.

struct LicoUniforms {
    float4 resolution_time;
    float4 mouse;
    float4 date;
    float4 timing;
    uint4 render_control;
    float4 focus_control;
    float analysis[128];
};
static_assert(__builtin_offsetof(LicoUniforms, analysis) == 24 * sizeof(float));
static_assert(sizeof(LicoUniforms) == 152 * sizeof(float));

namespace lico {

inline constexpr float pi = 3.14159265359f;
inline constexpr float tau = 6.28318530718f;
inline constexpr uint waveform_base = 0;
inline constexpr uint waveform_count = 64;
inline constexpr uint spectrum_base = 64;
inline constexpr uint spectrum_count = 40;
inline constexpr uint hits_base = 104;
inline constexpr uint phases_base = 112;
inline constexpr uint track_count = 8;

enum Feature : uint {
    rms = 120,
    bass,
    mids,
    treble,
    beat_phase,
    playing,
    onset,
    track_density,
};

inline float saturate(float value)
{
    return clamp(value, 0.0f, 1.0f);
}

inline float frac(float value)
{
    return value - floor(value);
}

inline float sample(__global const float *data, uint base, uint count, float position)
{
    const float offset = saturate(position) * static_cast<float>(count - 1);
    const uint left = static_cast<uint>(offset);
    const uint right = min(left + 1u, count - 1u);
    return mix(data[base + left], data[base + right], offset - static_cast<float>(left));
}

inline float3 palette(float hue)
{
    const float3 violet = (float3)(0.61f, 0.077f, 1.00f);
    const float3 marine = (float3)(0.028f, 0.82f, 1.00f);
    const float3 amber = (float3)(1.00f, 0.37f, 0.080f);
    return mix(mix(violet, marine, smoothstep(0.0f, 0.62f, hue)),
        amber, smoothstep(0.64f, 1.0f, hue));
}

inline float stroke(float distance, float width, float pixel)
{
    return 1.0f - smoothstep(width, width + pixel, fabs(distance));
}

inline float halo(float distance, float sharpness)
{
    return native_exp2(-fabs(distance) * sharpness);
}

inline float frame_grain(uint2 cell)
{
    uint value = cell.x * 0x9E3779B9u ^ cell.y * 0x85EBCA6Bu;
    value ^= value >> 16;
    value *= 0x7FEB352Du;
    value ^= value >> 15;
    return (float)(value & 0xffffu) * (1.0f / 65535.0f);
}

inline float3 background(float2 uv, uint2 pixel, float energy)
{
    const float2 center = uv - (float2)(0.51f, 0.58f);
    const float vignette = saturate(1.0f - 1.52f * dot(center, center));
    const float light = native_exp2(-7.0f * dot(center, center));
    const float grain = frame_grain(pixel >> 1) * 0.00075f;
    return (float3)(0.0016f, 0.0025f, 0.0075f) * (0.52f + 0.85f * vignette)
        + (float3)(0.014f, 0.006f, 0.043f) * light * (0.16f + 0.32f * energy)
        + grain;
}

inline float3 sequencer(__global const float *data, float2 uv, float pixel)
{
    const float x = (uv.x - 0.075f) * (1.0f / 0.85f);
    const float lane = (0.152f - uv.y) * (1.0f / 0.0158f);
    const uint track = min(static_cast<uint>(max(lane, 0.0f)), track_count - 1);
    const float divider = stroke(uv.y - 0.171f, 0.0f, pixel * 0.52f);
    const float rails = step(0.0f, x) * step(x, 1.0f);
    float3 color = (float3)(0.014f, 0.028f, 0.065f) * divider * rails;
    if (lane < 0.0f || lane >= static_cast<float>(track_count)) {
        return color;
    }

    const float phase = data[phases_base + track];
    if (phase < 0.0f) {
        return color;
    }
    const float hit = saturate(data[hits_base + track]);
    const float3 tint = palette(static_cast<float>(track) / 7.0f);
    const float slot = frac(x * 16.0f);
    const float row = frac(lane) - 0.5f;
    const float cell = smoothstep(0.035f, 0.075f, slot)
        * (1.0f - smoothstep(0.925f, 0.965f, slot))
        * (1.0f - smoothstep(0.30f, 0.47f, fabs(row)));
    const float playhead = stroke(x - phase, 0.0007f, pixel);
    const float tail = halo(x - phase, 37.0f) * step(x, phase);
    const float head = halo(x + 0.015f, 400.0f)
        * (1.0f - smoothstep(0.16f, 0.40f, fabs(row)));
    color += tint * rails * cell * (0.012f + 0.12f * tail + 0.27f * hit * tail);
    color += tint * rails * playhead * (0.16f + 0.75f * hit)
        * (1.0f - smoothstep(0.35f, 0.5f, fabs(row)));
    color += tint * head * (0.10f + 0.70f * hit);
    return color;
}

inline float3 aperture(__global const float *data, float2 p, float time, float pixel)
{
    constexpr float bar_start = 0.615f;
    constexpr float bar_end = 0.632f;
    constexpr float bar_height = 0.25f;
    constexpr float treble_height = 0.055f;
    constexpr float tip_width = 0.0014f;
    const float bar_limit = bar_end + (bar_height + treble_height) + tip_width + pixel;
    const float radius = native_sqrt(dot(p, p));
    const float activity = saturate(data[playing]);
    const float low = saturate(data[bass]);
    const float3 lens = (float3)(0.19f, 0.081f, 0.58f) * native_exp2(-13.0f * radius * radius)
        * (0.027f + 0.13f * low * activity);
    // Beyond this radius, every stroke has zero coverage and the remaining
    // ring halos together contribute less than 3e-6 per linear-color channel.
    if (radius > max(1.09f, bar_limit)) {
        return lens;
    }

    const float heading = atan2(p.y, p.x) * (1.0f / tau) + 0.5f;
    const float energy = saturate(data[rms]);
    const float middle = saturate(data[mids]);
    const float high = saturate(data[treble]);
    const float transient = saturate(data[onset]) * activity;
    const float phase = saturate(data[beat_phase]);
    const float density = saturate(data[track_density]);
    const float seam = smoothstep(0.0f, 0.055f, min(heading, 1.0f - heading));
    const float spectral_heading = saturate(1.0f - fabs(2.0f * heading - 1.0f));
    const float soft_band = sample(data, spectrum_base, spectrum_count, spectral_heading) * activity;
    const float wave = sample(data, waveform_base, waveform_count, heading) * seam;
    const float glow = 0.36f + 0.64f * activity;
    const float hue = saturate(0.48f + p.x * 0.47f + 0.11f * native_sin(radius * 9.0f - time * 0.22f));
    const float3 light = palette(hue);

    // Forty mirrored spectrum bars make the outside of the ring. Radius
    // follows the spectrum while hue runs from violet to blue and copper.
    float3 color = (float3)(0.0f);
    if (radius >= min(bar_start, bar_end - tip_width - pixel) && radius <= bar_limit) {
        const float slots = spectral_heading * static_cast<float>(spectrum_count);
        const uint bin = min(static_cast<uint>(slots), spectrum_count - 1);
        const float band = saturate(data[spectrum_base + bin]) * activity;
        const float edge = fabs(frac(slots) - 0.5f);
        const float sector = 1.0f - smoothstep(0.33f, 0.48f, edge);
        const float outer = bar_end + (bar_height + treble_height * high) * band;
        const float bar = step(bar_start, radius) * (1.0f - smoothstep(outer, outer + pixel, radius));
        const float tip = stroke(radius - outer, tip_width, pixel);
        color = palette(0.15f + 0.82f * spectral_heading) * sector
            * (bar * (0.019f + 0.21f * band) + tip * (0.028f + 0.30f * band)) * glow;
    }

    // The live waveform bends the luminous inner edge. A wider bloom
    // and a weaker echo line give the edge depth at low levels.
    const float rim = 0.552f + 0.040f * low + 0.039f * soft_band + 0.11f * wave;
    const float rim_distance = radius - rim;
    color += light * stroke(rim_distance, 0.002f, pixel) * (0.26f + 0.47f * energy) * glow;
    color += light * halo(rim_distance, 78.0f) * (0.040f + 0.26f * soft_band) * glow;
    color += light.zyx * halo(rim_distance + 0.063f, 49.0f)
        * (0.016f + 0.084f * middle + 0.20f * transient);

    // The waveform is drawn a second time as a linear scope through the lens.
    constexpr float scope_edge = 0.53f;
    if (radius < scope_edge) {
        const float wave_x = p.x * 0.95f + 0.5f;
        const float inside = 1.0f - smoothstep(0.475f, scope_edge, radius);
        const float line = sample(data, waveform_base, waveform_count, wave_x);
        const float scope = p.y - line * (0.77f + 0.19f * energy);
        const float scope_mask = inside * smoothstep(0.0f, 0.09f, min(wave_x, 1.0f - wave_x));
        color += palette(0.26f + 0.49f * wave_x) * scope_mask
            * (stroke(scope, 0.0012f, pixel) * (0.19f + 0.43f * activity)
                + halo(scope, 76.0f) * (0.025f + 0.10f * energy));
        color += (float3)(0.009f, 0.017f, 0.035f) * inside
            * stroke(p.y, 0.0f, pixel * 0.60f);
    }

    // Slow contours, sparse ruler marks, and an actual transport phase.
    const float ticks = step(0.93f, frac(heading * 32.0f));
    const float compass = stroke(radius - 0.930f, 0.0f, pixel * 0.66f);
    const float phase_edge = fabs(frac(heading - phase + 0.5f) - 0.5f);
    const float phase_glow = halo(phase_edge, 83.0f) * activity;
    color += (float3)(0.075f, 0.086f, 0.18f) * ticks * compass;
    color += (float3)(1.0f, 0.37f, 0.079f) * halo(radius - 0.933f, 117.0f)
        * phase_glow * (0.18f + 0.49f * transient + 0.12f * density);
    return color + lens;
}

inline uint pack(float3 color)
{
    const float3 tone = native_sqrt(clamp(color / (0.78f + color), 0.0f, 1.0f));
    const uint3 bytes = convert_uint3_sat_rte(tone * 255.0f);
    return 0xff000000u | (bytes.z << 16) | (bytes.y << 8) | bytes.x;
}

} // namespace lico

kernel __attribute__((intel_reqd_sub_group_size(16))) void shadertoy_lico(
    __global uint *output,
    __global const LicoUniforms *uniforms,
    uint width,
    uint height,
    uint pitch_bytes)
{
    const uint x = get_global_id(0);
    const uint y = get_global_id(1);
    if (x >= width || y >= height) {
        return;
    }
    const float2 size = (float2)((float)width, (float)height);
    const float2 uv = (float2)((float)x + 0.5f, (float)(height - y) - 0.5f) / size;
    __global const float *data = uniforms->analysis;
    const float extent = min(size.x / 1.14f, size.y * 0.812f);
    const float pixel = 2.0f / extent;
    const float2 centered = (uv - (float2)(0.5f, 0.585f)) * size * pixel;
    float3 color = lico::background(uv, (uint2)(x, y), lico::saturate(data[lico::rms]));
    if (uv.y < 0.176f) {
        color += lico::sequencer(data, uv, 1.0f / min(size.x, size.y));
    } else {
        color += lico::aperture(data, centered, uniforms->resolution_time.w, pixel);
    }
    output[(size_t)y * (pitch_bytes / sizeof(uint)) + x] = lico::pack(color);
}
