## RetainedFrameSubmit
repr: {"align": null, "int": null, "kind": "c", "packed": null}

struct RetainedFrameSubmit {
  surface: u64,
  mesh: u64,
  material: RetainedMaterial,
  // Owner-scoped generation-checked vmedia material bundle. A POS_NORMAL_UV retained mesh requires the base-color slot; remaining glTF slots are optional but, when present, are validated together.
  static_vertex_buffer: u64,
  static_index_buffer: u64,
  static_vertex_offset: u64,
  static_index_offset: u64,
  clear_rgba8_srgb: u32,
  seed_count: u32,
  static_draw_count: u32,
  static_vertex_revision: u32,
  // Caller-owned content token for `static_vertex_buffer`. Advance it after rewriting any static vertex payload so a retained mesh refreshes its resident copy in place. Indices and draw identity remain immutable.
  camera: RetainedCamera,
  // Live camera data for the native retained vertex shader.
  seeds: [RetainedTransformSeed; 4],
  static_draws: [IndexedBatchDrawV2; 3],
}
