## IndexedDraw
repr: {"align": null, "int": null, "kind": "c", "packed": null}

struct IndexedDraw {
  surface: u64,
  pipeline: u64,
  vertex_buffer: u64,
  index_buffer: u64,
  vertex_offset: u64,
  index_offset: u64,
  index_count: u32,
  first_index: u32,
  base_vertex: i32,
  clear_rgba8_srgb: u32,
  topology: u32,
  // Zero preserves the legacy triangle list. Explicit triangle lists and native quad lists are supported; all other values are rejected. This occupies the former zero-reserved word without changing layout.
  sampled_texture: u64,
  // Optional buffer-backed tightly packed RGBA8 sampled texture.
  texture_width: u32,
  texture_height: u32,
  texture_pitch: u32,
  sampler_flags: u32,
  texture_reserved: u32,
  // INDEXED_DRAW_* flags. Zero keeps the original clear + depth-tested draw.
}
