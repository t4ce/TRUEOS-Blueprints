# Public C ABI data layouts
Fields are in repr(C) order. This is not a packed serialization: honor native alignment, pointers, padding and array lengths. Raw-pointer mutability indicates direction; explicit lengths remain authoritative. Numeric byte offsets are not synthesized by rustdoc.

## AudioEndpointCapabilitiesV1
repr: {"align": null, "int": null, "kind": "c", "packed": null}
Versioned read-only host HDA playback endpoint snapshot.

`ready == 0` is a successful unavailable result. The active stream stays
fixed; advertised masks describe the selected DAC rather than requesting a
format switch.
struct AudioEndpointCapabilitiesV1 {
  version: u16,
  size: u16,
  sample_rate_hz: u32,
  dma_buffer_frames: u32,
  queued_pcm_lane_frames: u32,
  selected_dac_pcm_rates: u32,
  selected_dac_stream_formats: u32,
  controller_output_streams: u8,
  active_channels: u8,
  active_sample_bits: u8,
  active_frame_bytes: u8,
  ready: u8,
  controller_addr64: u8,
  output_path_count: u8,
  selected_output_path_index: u8,
  reserved1: u64,
  reserved2: u64,
}
